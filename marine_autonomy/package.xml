<package format="2">
  <name>marine_autonomy</name>
  <version>0.0.0</version>
  <description>The Project 11 package</description>
  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>
  
  <license>BSD-3-Clause</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- include/marine_autonomy/gz4d_geo.h includes boost/math/quaternion.hpp
       (header-only), so consumers of this package's headers need it too:
       depend, not build_depend. libboost-dev is the Boost headers package. -->
  <depend>libboost-dev</depend>
  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>marine_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf_transformations</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
