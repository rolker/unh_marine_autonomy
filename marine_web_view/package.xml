<?xml version="1.0"?>
<package format="2">
  <name>marine_web_view</name>
  <version>0.0.0</version>
  <description>
    Public web view of vessel state: a ROS 2 node that renders live boat
    position and heading to static GeoJSON in an S3 bucket, and the static
    page that displays it. Deliberately one-way -- no ROS surface is exposed
    to the internet.
  </description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>marine_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geographic_msgs</depend>
  <!-- coverage_renderer reads the chart-datum offset (the tide) from TF. -->
  <depend>tf2_ros</depend>
  <!-- Runtime deps of coverage_renderer: numpy for band decode and
       sampling, Pillow for PNG encoding. rosdep keys, not pip. -->
  <depend>python3-numpy</depend>
  <depend>python3-pil</depend>
  <!-- Both renderers shell out to the AWS CLI (`aws s3 cp`) to write
       objects, but the CLI is deliberately NOT declared here. The `awscli`
       rosdep key resolves to the apt package of the same name, which has no
       installation candidate on Ubuntu noble, so declaring it aborts the
       whole hosted build at `rosdep install` before anything is compiled.
       The operator's CLI is the userland AWS CLI v2 installer, which apt
       could never provide. It is an operator-provided runtime prerequisite,
       documented in README.md; state_renderer has shipped on jazzy the same
       way. Everything except the S3 upload runs without it, and dry_run
       needs it not at all. Tracked for removal in #351: moving the upload
       path to boto3 makes the dependency declarable. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
