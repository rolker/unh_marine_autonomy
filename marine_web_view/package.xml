<?xml version="1.0"?>
<package format="2">
  <name>marine_web_view</name>
  <version>0.0.0</version>
  <description>
    Public web view of vessel state: a ROS 2 node that renders live boat
    position and heading to static GeoJSON in an S3 bucket, and the static
    page that displays it. Deliberately one-way -- no ROS surface is exposed
    to the internet.
  </description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>marine_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geographic_msgs</depend>
  <!-- coverage_renderer reads the chart-datum offset (the tide) from TF. -->
  <depend>tf2_ros</depend>
  <!-- Runtime deps of coverage_renderer: numpy for band decode and
       sampling, Pillow for PNG encoding. rosdep keys, not pip. -->
  <depend>python3-numpy</depend>
  <depend>python3-pil</depend>
  <!-- S3 uploads (both renderers and scripts/refresh_chart_tiles.py) go
       through boto3. Declarable, unlike the AWS CLI it replaced: `awscli`
       resolves to an apt package with no installation candidate on noble,
       so declaring it aborted the hosted build at `rosdep install` (#351).
       botocore arrives transitively via apt, as numpy's and Pillow's own
       dependencies do.

       depend, not exec_depend, deliberately: boto3 is a runtime import
       only (nothing here builds against it), so exec_depend would be the
       narrower-correct tag. But python3-numpy and python3-pil, runtime
       imports in exactly the same way, are declared with depend just above;
       declaring the third one differently would read as a distinction that
       does not exist. rosdep install resolves the two identically, so the
       redundancy costs nothing. Verified: rosdep resolve python3-boto3
       yields apt python3-boto3, candidate 1.34.46+dfsg-1ubuntu1 on noble. -->
  <depend>python3-boto3</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
